# Copy to .env (or export in shell) to run live multimodal model benchmarks.
# Free-tier Google AI Studio key works with Gemini REST / SDK:
GEMINI_API_KEY=

# Optional OpenAI-compatible endpoints (OpenAI, OpenRouter, Groq, Together, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional local Ollama host (e.g., `ollama pull qwen2.5vl:3b`)
OLLAMA_HOST=http://localhost:11434
